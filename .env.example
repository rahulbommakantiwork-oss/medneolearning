# Server-side Supabase credentials (never use these in browser code)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative is accepted only if SUPABASE_SECRET_KEY is empty:
SUPABASE_SERVICE_ROLE_KEY=
# Use a long random secret (at least 32 bytes); rotate invalidates sessions:
GML_SESSION_SECRET=
APP_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app

# Optional welcome email after a doctor creates an account
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedNeo <onboarding@your-verified-domain.com>


# Vercel cron authentication for private nightly database snapshots
CRON_SECRET=

# First admin bootstrap only; existing records are not modified by seed.mjs
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=

# Local testing only; never set these on Vercel/production. Shows one-time links in the local UI when email is not configured.
DEV_SHOW_RESET_LINK=false
DEV_SHOW_SETUP_LINK=false
